  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@huggingface/transformers": "^4.2.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "mespeak": "^2.0.2",
    "opusscript": "^0.0.8"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true,
    "onnxruntime-node@1.24.3": true
  }
