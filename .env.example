# --- Discord ---
# Create a bot at https://discord.com/developers/applications
# (Application > Bot > Reset Token). Enable these Privileged Gateway Intents:
#   Server Members (optional), Presence (not needed), Message Content (not needed)
# Invite the bot with scope "bot" + "applications.commands" and the
# "Connect" and "Speak" voice permissions.
DISCORD_TOKEN=

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:2b
LLM_TEMPERATURE=0.7
LLM_REPEAT_PENALTY=1.3
LLM_MAX_TOKENS=150
LLM_TIMEOUT_MS=30000
MAX_MESSAGE_CHARS=600
LLM_CONTEXT_SIZE=4096

# --- Speech-to-text (local Whisper via transformers.js) ---
# whisper-small is a big accuracy step up from tiny; q8 keeps it light (~230MB).
# For more accuracy (slower): onnx-community/whisper-medium
# For less RAM (less accurate): onnx-community/whisper-base
STT_MODEL=onnx-community/whisper-base
STT_FALLBACK_MODEL=onnx-community/whisper-tiny.en
STT_DTYPE=q8
# Optional: force a language, e.g. STT_LANGUAGE=en
STT_LANGUAGE=
STT_WORKERS=1
STT_THREADS=4

# --- Text-to-speech (local eSpeak via mespeak — robotic on purpose) ---
TTS_SPEED=165
TTS_MAX_CHARS=300
REPLY_MAX_CHARS=120

# --- Conversation memory ---
# Personality / behavior instructions for the model.
# SYSTEM_PROMPT=
HISTORY_LIMIT=6
MEMORY_FILE=./data/memory.json

# --- Voice capture tuning ---
SILENCE_DURATION_MS=500
MAX_CAPTURE_MS=30000
AUTO_LEAVE_EMPTY=true

# --- Voice activity detection (ignores clicks/noise before Whisper) ---
# A clip is treated as speech when it has at least VAD_MIN_ACTIVE_MS of
# audio above VAD_RMS_THRESHOLD *and* active frames make up at least
# VAD_MIN_ACTIVE_FRACTION of the clip. Lower VAD_RMS_THRESHOLD if quiet
# speech gets ignored; raise VAD_MIN_ACTIVE_MS if clicks still get through.
VAD_RMS_THRESHOLD=0.02
VAD_MIN_ACTIVE_MS=150
VAD_MIN_ACTIVE_FRACTION=0.1

# --- Memory summarization (folds old messages into a compact summary) ---
SUMMARIZE_AFTER=7
SUMMARY_KEEP=6

# --- Identity ---
BOT_NAME=Bobby
BOT_ALIASES=robot,ai,clanker

# --- Conversation behavior ---
# Respond without the name while the conversation is live (bot spoke within
# CONTINUATION_WINDOW_MS). Set RESPOND_WITHOUT_NAME=false for strict wake-word only.
RESPOND_WITHOUT_NAME=true
CONTINUATION_WINDOW_MS=45000
# Silero VAD (in the worker, before Whisper) rejects music and game audio
VAD_PROB_THRESHOLD=0.5
VAD_MIN_SPEECH_FRAMES=6
VAD_MIN_SPEECH_FRACTION=0.12
VAD_CONFIDENCE_THRESHOLD=0.9
VAD_MIN_CONFIDENT_FRAMES=3
TTS_PITCH=55
TTS_VARIANT=m3
MIN_RESPONSE_WORDS=3
SUMMARY_KEYWORD_CAP=60
SUMMARY_SHOWN_KEYWORDS=40
SUMMARY_NOTE_CAP=8
SAY_COOLDOWN_MS=30000
UNNAMED_COOLDOWN_MS=20000
